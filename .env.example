# Скопируйте в .env (рядом с server.py) и при необходимости поправьте.
# Логин и пароль оператора здесь НЕ нужны — их вводят в приложении при входе.

# Адрес Gizmo Web API (если сервер Gizmo на этом же ПК — оставьте как есть)
GIZMO_URL=http://localhost:8080

# На каком порту открывать приложение
LISTEN_PORT=8787
# 0.0.0.0 — доступно из локальной сети и Tailscale; 127.0.0.1 — только с этого ПК
LISTEN_HOST=0.0.0.0

# Название, которое видно в приложении
CLUB_NAME=Зал 1

# Широковещательный адрес сети клуба для Wake-on-LAN (обычно так и оставить)
WOL_BROADCAST=255.255.255.255

# Через сколько часов просить войти заново
SESSION_HOURS=12
