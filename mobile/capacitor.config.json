  "appName": "Админка",
  "webDir": "www",
  "appendUserAgent": "ClubAdminApp",
  "backgroundColor": "#0E1116",
  "server": {
    "cleartext": true,
    "allowNavigation": ["*", "*.*", "*.*.*", "*.*.*.*", "*.*.*.*.*", "*.*.*.*.*.*"]
